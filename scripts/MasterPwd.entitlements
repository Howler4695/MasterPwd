<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime with NO exceptions: no JIT, no unsigned memory, no
  library-validation bypass, no DYLD variables, no debugger attach.
  No network entitlement of any kind.
-->
<plist version="1.0">
<dict>
	<!-- Smart cards (CAC/PIV) as a second factor: reader access for
	     TKSmartCardSlotManager (diagnostic) and token keychain items. -->
	<key>com.apple.security.smartcard</key>
	<true/>
</dict>
</plist>
